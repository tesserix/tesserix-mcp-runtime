{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "mcp-server-reference",
    "labels": {
      "app.kubernetes.io/name": "mcp-server-reference",
      "app.kubernetes.io/component": "mcp-server"
    }
  },
  "spec": {
    "type": "ClusterIP",
    "sessionAffinity": "None",
    "selector": {
      "app.kubernetes.io/name": "mcp-server-reference"
    },
    "ports": [
      {
        "name": "http",
        "port": 8000,
        "targetPort": "http",
        "protocol": "TCP"
      }
    ]
  }
}
