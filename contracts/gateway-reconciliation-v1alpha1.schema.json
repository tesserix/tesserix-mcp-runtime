{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tesserix/tesserix-mcp-runtime/contracts/gateway-reconciliation-v1alpha1.schema.json",
  "title": "Tesserix tenant-scoped Gateway reconciliation snapshot v1alpha1",
  "description": "One complete, canonical desired state assembled before apply or prune.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environment",
    "generation",
    "observedAt",
    "complete",
    "routeCount",
    "resourceCount",
    "tenantCount",
    "routes",
    "tenants",
    "snapshotDigest",
    "requestId"
  ],
  "properties": {
    "schemaVersion": {"const": "v1alpha1"},
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "observedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "complete": {"const": true},
    "routeCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "resourceCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4000
    },
    "tenantCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "routes": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/route"}
    },
    "tenants": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/tenant"}
    },
    "snapshotDigest": {"$ref": "#/$defs/digest"},
    "requestId": {"$ref": "#/$defs/requestId"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "serverName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 32,
      "pattern": "Z$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "tenantId",
        "serverName",
        "registryDigest",
        "artifactDigest",
        "renderedDigest",
        "resourceCount",
        "activationGeneration",
        "identityDigest",
        "resourceName",
        "routePath",
        "scope",
        "policyName"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^mcpservers/[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?@[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "tenantId": {"$ref": "#/$defs/tenantId"},
        "serverName": {"$ref": "#/$defs/serverName"},
        "registryDigest": {"$ref": "#/$defs/digest"},
        "artifactDigest": {"$ref": "#/$defs/digest"},
        "renderedDigest": {"$ref": "#/$defs/digest"},
        "resourceCount": {
          "type": "integer",
          "minimum": 3,
          "maximum": 4
        },
        "activationGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "identityDigest": {"$ref": "#/$defs/digest"},
        "resourceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "routePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 132,
          "pattern": "^/mcp/[a-z0-9-]+/[a-z0-9-]+$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131,
          "pattern": "^mcp:[a-z0-9-]+:[a-z0-9-]+$"
        },
        "policyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        }
      }
    },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "generation",
        "state",
        "desiredRouteCount",
        "complete",
        "pruneAuthorized",
        "requestId"
      ],
      "properties": {
        "tenantId": {"$ref": "#/$defs/tenantId"},
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "state": {
          "enum": ["ready", "pending", "suspended", "deactivated"]
        },
        "desiredRouteCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "complete": {"const": true},
        "pruneAuthorized": {"type": "boolean"},
        "requestId": {"$ref": "#/$defs/requestId"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"not": {"const": "ready"}}}},
          "then": {"properties": {"desiredRouteCount": {"const": 0}}}
        },
        {
          "if": {"properties": {"state": {"const": "pending"}}},
          "then": {"properties": {"pruneAuthorized": {"const": false}}}
        }
      ]
    },
    "page": {
      "title": "Tesserix tenant-scoped Gateway reconciliation page v1alpha1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "environment",
        "generation",
        "observedAt",
        "snapshotDigest",
        "pageIndex",
        "pageSize",
        "routeCount",
        "resourceCount",
        "tenantCount",
        "cursor",
        "nextCursor",
        "complete",
        "routes",
        "tenants",
        "requestId"
      ],
      "properties": {
        "schemaVersion": {"const": "v1alpha1"},
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "observedAt": {"$ref": "#/$defs/timestamp"},
        "snapshotDigest": {"$ref": "#/$defs/digest"},
        "pageIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "routeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "resourceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        },
        "tenantCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "cursor": {
          "oneOf": [
            {"$ref": "#/$defs/cursor"},
            {"type": "null"}
          ]
        },
        "nextCursor": {
          "oneOf": [
            {"$ref": "#/$defs/cursor"},
            {"type": "null"}
          ]
        },
        "complete": {"type": "boolean"},
        "routes": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/route"}
        },
        "tenants": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tenant"}
        },
        "requestId": {"$ref": "#/$defs/requestId"}
      },
      "allOf": [
        {
          "if": {"properties": {"pageIndex": {"const": 0}}},
          "then": {"properties": {"cursor": {"type": "null"}}},
          "else": {"properties": {"cursor": {"$ref": "#/$defs/cursor"}}}
        },
        {
          "if": {"properties": {"complete": {"const": true}}},
          "then": {"properties": {"nextCursor": {"type": "null"}}},
          "else": {"properties": {"nextCursor": {"$ref": "#/$defs/cursor"}}}
        }
      ]
    }
  }
}
